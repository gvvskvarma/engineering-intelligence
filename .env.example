# Supabase — supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — aistudio.google.com (free, no card required)
GEMINI_API_KEY=your-gemini-api-key

# GitHub OAuth App — github.com/settings/developers
# Dev callback: http://localhost:3000/auth/callback
# Prod callback: https://your-app.vercel.app/auth/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Cloudflare R2 — cloudflare.com → R2 (optional, for file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eng-intelligence
R2_PUBLIC_URL=

# Backend URL (consumed by apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# API server config (apps/api)
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Next.js
NEXTAUTH_SECRET=replace-with-random-32-char-string
